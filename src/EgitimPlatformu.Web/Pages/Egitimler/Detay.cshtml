@page "/Egitimler/Detay/{id?}"
@model EgitimPlatformu.Web.Pages.Egitimler.DetayModel
@{ ViewData["Title"] = Model.Egitim?.Baslik ?? "Ders bulunamadı"; }
@if (Model.Hata is not null || Model.Egitim is null)
{
    <div class="empty-courses" role="alert"><h1>@(Model.Hata ?? "Aradığın ders bulunamadı.")</h1><p>Diğer dersleri incelemek için kataloğa dönebilirsin.</p><a asp-page="/Egitimler/Index" class="btn btn-primary">Eğitimlere dön</a></div>
}
else
{
    <nav aria-label="İçerik yolu" class="lesson-breadcrumb"><a asp-page="/Egitimler/Index">Eğitimler</a><span aria-hidden="true">/</span><a asp-page="/Egitimler/Index" asp-route-kategoriId="@Model.Egitim.KategoriId">@(Model.Egitim.Kategori?.Ad ?? "Kategorisiz")</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Egitim.Kod</span></nav>
    <header class="page-heading lesson-heading"><p class="eyebrow">@Model.Egitim.Kod · @(Model.Egitim.Kategori?.Ad ?? "Kategorisiz")</p><h1>@Model.Egitim.Baslik</h1><p>@Model.Gorevler.Count görev · Kendi hızında öğren, uygulayarak pekiştir.</p></header>
    <div class="row gy-4 gx-lg-5 lesson-layout">
        <aside class="col-lg-4 order-lg-2">
            <nav class="lesson-sidebar curriculum-panel" aria-labelledby="curriculum-title">
                <div class="curriculum-heading"><h2 id="curriculum-title">@(Model.Egitim.Kategori?.Ad ?? "Kategorisiz ders")</h2>
                    <p class="curriculum-subtitle">Eğitim içeriği</p>
                    <div class="curriculum-anchors"><a href="#ders-icerigi">İçerik</a><a href="#kod-editoru">Kod editörü</a><a href="#gorevler">Görevler</a></div>
                    <button type="button" class="btn btn-outline-primary d-lg-none w-100 mt-2" data-bs-toggle="collapse" data-bs-target="#egitim-icerigi" aria-expanded="false" aria-controls="egitim-icerigi">Ders menüsünü aç / kapat</button>
                </div>
                <div id="egitim-icerigi" class="collapse d-lg-block curriculum-body">
                    <ol class="curriculum-list">
                    @foreach (var ders in Model.KategoriDersleri)
                    {
                        var aktif = ders.Id == Model.Egitim.Id;
                        <li class="@(aktif ? "is-active" : null)">
                            <a asp-page="./Detay" asp-route-id="@ders.Id" aria-current="@(aktif ? "page" : null)">@(ders.Kod + ": " + ders.Baslik)</a>
                        </li>
                    }
                    </ol>
                    @if (Model.KategoriDersleri.Count == 0) { <p>Bu ders bir kategoriye bağlı değil.</p> }
                </div>
            </nav>
        </aside>
        <div class="col-lg-8 order-lg-1">
            <section id="ders-icerigi" class="content-panel" aria-labelledby="content-title"><h2 id="content-title" class="panel-title">Ders içeriği</h2>
                @if (string.IsNullOrWhiteSpace(Model.IcerikHtml)) { <p>Bu dersin içeriği henüz eklenmemiş.</p> }
                else { <div class="markdown-content">@Html.Raw(Model.IcerikHtml)</div> }
                @if (Model.IlerlemeMesaji is { } mesaj) { <p role="status" class="mt-3">@mesaj</p> }
                @if (Model.Ilerleme?.ElleTamamlanabilir == true)
                {
                    <form class="mt-3" method="post" asp-page-handler="Tamamla" asp-route-id="@Model.Egitim.Id">
                        <button type="submit" class="btn btn-outline-primary">Tamamlandı olarak işaretle</button>
                    </form>
                }
                else if (Model.Ilerleme?.Tamamlandi == true && Model.IlerlemeMesaji is null)
                {
                    <span class="badge text-bg-success mt-3">Ders tamamlandı</span>
                }
            </section>
            @if (Model.Notebooklar.Count > 0)
            {
                <section class="content-panel mt-4" aria-labelledby="notebook-title">
                    <h2 id="notebook-title" class="panel-title">Notebook’lar</h2>
                    <ul>
                    @foreach (var notebook in Model.Notebooklar)
                    {
                        <li><a asp-page="/Notebooklar/Detay" asp-route-id="@notebook.Id">@notebook.Baslik</a></li>
                    }
                    </ul>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Egitim.BaslangicKodu))
            {
                <section id="baslangic-kodu" class="content-panel mt-4" aria-labelledby="starter-title"><h2 id="starter-title" class="panel-title">Başlangıç kodu</h2><p class="section-note">Bu şablonu aşağıdaki kod alanında düzenleyebilirsin.</p><pre class="starter-code"><code>@Model.Egitim.BaslangicKodu</code></pre></section>
            }
            <partial name="_KodEditoru" model="Model" />
            <section id="gorevler" class="content-panel mt-4" aria-labelledby="tasks-title"><h2 id="tasks-title" class="panel-title">Görevler <span class="task-count">@Model.Gorevler.Count</span></h2>
                @if (Model.Gorevler.Count == 0) { <p>Bu derse henüz görev eklenmemiş.</p> }
                @foreach (var gorev in Model.Gorevler)
                {
                    <details class="task-item" id="gorev-@gorev.Id"><summary><span class="task-no">@(gorev.No?.ToString() ?? "—")</span><span>@gorev.Baslik</span></summary><div class="markdown-content task-content">@Html.Raw(gorev.AciklamaHtml)</div></details>
                }
            </section>
            <nav class="lesson-pagination content-panel mt-4" aria-label="Dersler arasında gezinme">
                @if (Model.OncekiDers is { } onceki) { <a class="btn btn-outline-primary" asp-page="./Detay" asp-route-id="@onceki.Id" rel="prev">← Önceki ders <span>@onceki.Kod · @onceki.Baslik</span></a> }
                <a class="text-link" asp-page="./Index">Eğitimlere dön</a>
                @if (Model.SonrakiDers is { } sonraki) { <a class="btn btn-primary" asp-page="./Detay" asp-route-id="@sonraki.Id" rel="next">Sonraki ders → <span>@sonraki.Kod · @sonraki.Baslik</span></a> }
            </nav>
        </div>
    </div>
}
@section Scripts {
    @if (Model.Egitim is not null && Model.Hata is null)
    {
        <link rel="stylesheet" href="~/lib/monaco/editor.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/kod-editoru.css" asp-append-version="true" />
        <script type="module" src="~/js/kod-editoru.js" asp-append-version="true"></script>
        <script src="~/js/egitim-gezinme.js" asp-append-version="true" defer></script>
    }
}
