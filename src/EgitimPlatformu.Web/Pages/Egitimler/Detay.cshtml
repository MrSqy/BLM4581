@page "/Egitimler/Detay/{id?}"
@model EgitimPlatformu.Web.Pages.Egitimler.DetayModel
@{ ViewData["Title"] = Model.Egitim?.Baslik ?? "Ders bulunamadı"; }
@if (Model.Hata is not null || Model.Egitim is null)
{
    <div class="empty-courses" role="alert"><h1>@(Model.Hata ?? "Aradığın ders bulunamadı.")</h1><p>Diğer dersleri incelemek için kataloğa dönebilirsin.</p><a asp-page="/Egitimler/Index" class="btn btn-primary">Eğitimlere dön</a></div>
}
else
{
    <nav aria-label="İçerik yolu" class="lesson-breadcrumb"><a asp-page="/Egitimler/Index">Eğitimler</a><span aria-hidden="true">/</span><a asp-page="/Egitimler/Index" asp-route-kategoriId="@Model.Egitim.KategoriId">@(Model.Egitim.Kategori?.Ad ?? "Kategorisiz")</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Egitim.Kod</span></nav>
    <header class="page-heading lesson-heading"><p class="eyebrow">@Model.Egitim.Kod · @(Model.Egitim.Kategori?.Ad ?? "Kategorisiz")</p><h1>@Model.Egitim.Baslik</h1><p>@Model.Gorevler.Count görev · Kendi hızında öğren, uygulayarak pekiştir.</p></header>
    <div class="row gy-4 gx-lg-5 lesson-layout">
        <div class="col-lg-8">
            <section id="ders-icerigi" class="content-panel" aria-labelledby="content-title"><h2 id="content-title" class="panel-title">Ders içeriği</h2>
                @if (string.IsNullOrWhiteSpace(Model.IcerikHtml)) { <p>Bu dersin içeriği henüz eklenmemiş.</p> }
                else { <div class="markdown-content">@Html.Raw(Model.IcerikHtml)</div> }
            </section>
            @if (!string.IsNullOrWhiteSpace(Model.Egitim.BaslangicKodu))
            {
                <section id="baslangic-kodu" class="content-panel mt-4" aria-labelledby="starter-title"><h2 id="starter-title" class="panel-title">Başlangıç kodu</h2><p class="section-note">Bu şablonu kendi çalışma ortamında tamamlayabilirsin. Bu sayfada kod çalıştırılmaz.</p><pre class="starter-code"><code>@Model.Egitim.BaslangicKodu</code></pre></section>
            }
            <section id="gorevler" class="content-panel mt-4" aria-labelledby="tasks-title"><h2 id="tasks-title" class="panel-title">Görevler <span class="task-count">@Model.Gorevler.Count</span></h2>
                @if (Model.Gorevler.Count == 0) { <p>Bu derse henüz görev eklenmemiş.</p> }
                @foreach (var gorev in Model.Gorevler)
                {
                    <details class="task-item" id="gorev-@gorev.Id"><summary><span class="task-no">@(gorev.No?.ToString() ?? "—")</span><span>@gorev.Baslik</span></summary><div class="markdown-content task-content">@Html.Raw(gorev.AciklamaHtml)</div></details>
                }
            </section>
        </div>
        <aside class="col-lg-4"><nav class="lesson-sidebar" aria-label="Bu derste"><p class="eyebrow">BU DERSTE</p><a href="#ders-icerigi">Ders içeriği <span aria-hidden="true">↓</span></a>@if (!string.IsNullOrWhiteSpace(Model.Egitim.BaslangicKodu)) { <a href="#baslangic-kodu">Başlangıç kodu <span aria-hidden="true">↓</span></a> }<a href="#gorevler">Görevler <span>@Model.Gorevler.Count</span></a><hr /><p>Küçük adımlarla ilerle. Önce kendi çözümünü dene, ardından kontrol ölçütlerini gözden geçir.</p><a class="btn btn-outline-primary mt-3" asp-page="/Egitimler/Index" asp-route-kategoriId="@Model.Egitim.KategoriId">Kategorideki dersler</a></nav></aside>
    </div>
}
