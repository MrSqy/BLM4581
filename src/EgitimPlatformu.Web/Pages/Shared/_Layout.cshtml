<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EgitimPlatformu.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EgitimPlatformu.Web.styles.css" asp-append-version="true" />
</head>
<body>
    
<header>
    <nav class="navbar navbar-expand-lg bg-body border-bottom py-3">
        <div class="container-fluid px-3 px-xl-5">

            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4 me-4"
               asp-page="/Index">
                Eğitim Platformu
            </a>

            <!-- Mobil menü -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#anaMenu"
                    aria-controls="anaMenu"
                    aria-expanded="false"
                    aria-label="Menüyü aç veya kapat">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse gap-3" id="anaMenu">

                <!-- Sayfa bağlantıları -->
                <ul class="navbar-nav mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link nav-hover" asp-page="/Index">
                            Eğitimler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-hover" asp-page="/Index">
                            Kategoriler
                        </a>
                    </li>
                </ul>

                <!-- Arama alanı -->
                <form class="d-flex flex-grow-1"
                      role="search"
                      method="get"
                      action="/">
                    <input class="form-control rounded-pill px-4"
                           type="search"
                           name="q"
                           placeholder="Ne öğrenmek istersiniz?"
                           aria-label="Eğitim ara">
                </form>

                <!-- Kullanıcı işlemleri -->
                <div class="d-flex gap-2 flex-shrink-0">
                    <a class="btn btn-outline-primary"
                       asp-page="/Index">
                        Oturum Aç
                    </a>
                    <a class="btn btn-primary"
                       asp-page="/Index">
                        Kaydol
                    </a>
                </div>

            </div>
        </div>
    </nav>
</header>

    <main role="main">
        @RenderBody()
    </main>

    
    
<footer class="site-footer">
    <div class="container py-4">
        <div class="row g-3 align-items-start">

            <!-- Sol: Platform -->
            <div class="col-md-5">
                <a asp-page="/Index"
                   class="footer-brand text-decoration-none fw-bold fs-5">
                    Eğitim Platformu
                </a>
                <p class="footer-description small mt-2 mb-0">
                    Öğren, kodla ve geliştir.
                    İnteraktif eğitimlerle programlama becerilerini ilerlet.
                </p>
            </div>

            <!-- Orta: Eğitimler -->
            <div class="col-6 col-md-3">
                <h6 class="footer-heading">Eğitimler</h6>
                <ul class="list-unstyled footer-links mb-0">
                    <li>
                        <a asp-page="/Index"
                           asp-fragment="populer-egitimler">
                            Popüler Eğitimler
                        </a>
                    </li>
                    <li>
                        <a asp-page="/Index">Ana Sayfa</a>
                    </li>
                </ul>
            </div>

            <!-- Sağ: Platform bilgisi -->
            <div class="col-6 col-md-4">
                <h6 class="footer-heading">Platform</h6>
                <p class="footer-description small mb-0">
                    Kod yaz, çalıştır ve sonuçlarını anında gör.
                    Öğrenirken pratik yap.
                </p>
            </div>

        </div>
    </div>

    <div class="footer-bottom">
        <div class="container py-2">
            <span class="small">
                &copy; @DateTime.Now.Year Eğitim Platformu
            </span>
        </div>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
