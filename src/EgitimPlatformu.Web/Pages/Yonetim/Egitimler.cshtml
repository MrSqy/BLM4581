@page
@model EgitimPlatformu.Web.Pages.Yonetim.EgitimlerModel
@{ ViewData["Title"] = "Eğitim yönetimi"; }
<partial name="_Menu" /><header class="page-heading"><h1>Eğitimler</h1><p>Dersleri kategorilerle ilişkilendirin ve içeriklerini yönetin.</p></header>
<div asp-validation-summary="All" class="text-danger" role="alert"></div><partial name="_SilmeOnayi" model="Model" />
<div class="table-responsive management-table"><table class="table align-middle"><caption>Eğitim listesi</caption><thead><tr><th>Kod / başlık</th><th>Kategori</th><th>Sıra</th><th>İşlemler</th></tr></thead><tbody>@foreach (var e in Model.Kayitlar) { <tr><td>@e.Kod — @e.Baslik</td><td>@e.Kategori?.Ad</td><td>@e.Sira</td><td><a asp-route-duzenleId="@e.Id">Düzenle</a> · <a asp-route-silId="@e.Id">Sil</a></td></tr> }</tbody></table></div>
@if (Model.Kayitlar.Count == 0) { <p>Henüz eğitim yok.</p> }
<section class="content-panel mt-4"><h2>@(Model.DuzenleId.HasValue ? "Eğitimi düzenle" : "Yeni eğitim")</h2><form method="post" class="management-form"><input type="hidden" asp-for="DuzenleId" />
<div><label asp-for="Input.KategoriId" class="form-label"></label><select asp-for="Input.KategoriId" class="form-select"><option value="">Kategori seçin</option>@foreach (var k in Model.Kategoriler) { <option value="@k.Id">@k.Ad</option> }</select><span asp-validation-for="Input.KategoriId" class="text-danger"></span></div>
<div><label asp-for="Input.Kod" class="form-label"></label><input asp-for="Input.Kod" class="form-control" /><span asp-validation-for="Input.Kod" class="text-danger"></span></div>
<div><label asp-for="Input.Baslik" class="form-label"></label><input asp-for="Input.Baslik" class="form-control" /><span asp-validation-for="Input.Baslik" class="text-danger"></span></div>
<div><label asp-for="Input.Sira" class="form-label"></label><input asp-for="Input.Sira" class="form-control" /><span asp-validation-for="Input.Sira" class="text-danger"></span></div>
<div><label asp-for="Input.IcerikMarkdown" class="form-label"></label><textarea asp-for="Input.IcerikMarkdown" class="form-control" rows="9"></textarea><span asp-validation-for="Input.IcerikMarkdown" class="text-danger"></span></div>
<div><label asp-for="Input.BaslangicKodu" class="form-label"></label><textarea asp-for="Input.BaslangicKodu" class="form-control" rows="6" spellcheck="false"></textarea><span asp-validation-for="Input.BaslangicKodu" class="text-danger"></span></div>
<div><label asp-for="Input.TestKodu" class="form-label"></label><textarea asp-for="Input.TestKodu" class="form-control" rows="6" spellcheck="false"></textarea><span asp-validation-for="Input.TestKodu" class="text-danger"></span></div>
<p class="form-text">Görev bazlı derslerde başlangıç kodu ve kontrol ölçütleri Görevler bölümünden yönetilir.</p>
<div class="d-flex gap-3"><button class="btn btn-primary" type="submit">Kaydet</button><a asp-page="./Egitimler" class="btn btn-outline-primary">Yeni kayıt / temizle</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
