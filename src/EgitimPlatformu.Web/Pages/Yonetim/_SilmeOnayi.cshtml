@model EgitimPlatformu.Web.Pages.Yonetim.YonetimPageModel
@if (Model.SilinecekAd is not null)
{
    <section class="content-panel delete-confirmation" aria-labelledby="delete-title"><h2 id="delete-title">Silme onayı</h2><p><strong>@Model.SilinecekAd</strong> kaydını silmek üzeresiniz. @Model.SilmeNotu</p>
        <form method="post" asp-page-handler="Sil"><input type="hidden" name="id" value="@Model.SilId" /><div class="form-check my-3"><input class="form-check-input" type="checkbox" id="delete-confirm" name="Onay" value="true" required /><label class="form-check-label" for="delete-confirm">Silme işlemini onaylıyorum.</label></div><button class="btn btn-danger" type="submit">Kaydı sil</button><a asp-page="@ViewContext.RouteData.Values["page"]" class="btn btn-outline-primary">Vazgeç</a></form>
    </section>
}
