@page
@model EgitimPlatformu.Web.Pages.Yonetim.KategorilerModel
@{ ViewData["Title"] = "Kategori yönetimi"; }
<partial name="_Menu" /><header class="page-heading"><h1>Kategoriler</h1><p>Eğitim alanlarını ekleyin ve düzenleyin.</p></header>
<div asp-validation-summary="All" class="text-danger" role="alert"></div><partial name="_SilmeOnayi" model="Model" />
<div class="table-responsive management-table"><table class="table align-middle"><caption>Kategori listesi</caption><thead><tr><th>Ad</th><th>Kısaltma</th><th>Sıra</th><th>İşlemler</th></tr></thead><tbody>@foreach (var k in Model.Kayitlar) { <tr><td>@k.Ad</td><td>@k.Kisaltma</td><td>@k.Sira</td><td><a asp-route-duzenleId="@k.Id">Düzenle</a> · <a asp-route-silId="@k.Id">Sil</a></td></tr> }</tbody></table></div>
@if (Model.Kayitlar.Count == 0) { <p>Henüz kategori yok.</p> }
<section class="content-panel mt-4"><h2>@(Model.DuzenleId.HasValue ? "Kategoriyi düzenle" : "Yeni kategori")</h2><form method="post" class="management-form"><input type="hidden" asp-for="DuzenleId" />
<div><label asp-for="Input.Ad" class="form-label"></label><input asp-for="Input.Ad" class="form-control" /><span asp-validation-for="Input.Ad" class="text-danger"></span></div>
<div><label asp-for="Input.Kisaltma" class="form-label"></label><input asp-for="Input.Kisaltma" class="form-control" /><span asp-validation-for="Input.Kisaltma" class="text-danger"></span></div>
<div><label asp-for="Input.Aciklama" class="form-label"></label><textarea asp-for="Input.Aciklama" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Aciklama" class="text-danger"></span></div>
<div><label asp-for="Input.Sira" class="form-label"></label><input asp-for="Input.Sira" class="form-control" /><span asp-validation-for="Input.Sira" class="text-danger"></span></div>
<div class="d-flex gap-3"><button class="btn btn-primary" type="submit">Kaydet</button><a asp-page="./Kategoriler" class="btn btn-outline-primary">Yeni kayıt / temizle</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
